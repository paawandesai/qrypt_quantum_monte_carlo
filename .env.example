# Local configuration for scripts/ (copy to .env, which git ignores).
# Placeholders only. Real secrets live in SSM Parameter Store, never here.

AWS_REGION=us-east-1
# Function URL printed by `terraform output -raw api_url`
QMC_API_URL=https://example.lambda-url.us-east-1.on.aws/
# The API bearer key: fetch it with
#   aws ssm get-parameter --region us-east-1 --name /qrypt-mc/api-key --with-decryption --query Parameter.Value --output text
QMC_API_KEY=replace-me

# QRYPT_API_KEY is deliberately absent: the Qrypt token lives only in SSM
# (/qrypt-mc/qrypt-api-key), nothing local calls Qrypt, and tests use the mock.
